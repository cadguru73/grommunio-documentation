---
/**
 * Renders a brand-themed architecture diagram (generated by
 * scripts/gen-diagrams.mjs) with automatic dark/light variant swapping.
 * The diagram always scales to fit the column width (never clipped).
 * Usage: <Diagram name="workflow-protocol" alt="Protocol and component flow" />
 */
const { name, alt = '' } = Astro.props;
---
<figure class="gx-diagram not-content">
  <img class="gx-diagram__img for-dark" src={`/img/arch/${name}-dark.svg`} alt={alt} loading="lazy" decoding="async" />
  <img class="gx-diagram__img for-light" src={`/img/arch/${name}-light.svg`} alt={alt} loading="lazy" decoding="async" />
  {alt && <figcaption>{alt}</figcaption>}
</figure>

<style>
  .gx-diagram {
    margin: 1.75rem 0;
    padding: 1.1rem;
    border-radius: var(--radius-2xl, 1rem);
    border: 1px solid var(--sl-color-hairline-light);
    background:
      radial-gradient(120% 120% at 0% 0%, color-mix(in srgb, var(--gx-azure-500) 6%, transparent), transparent 60%),
      var(--sl-color-bg-sidebar);
  }
  /* Always scale to fit the column — never clipped, never overflowing */
  .gx-diagram__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    margin-inline: auto;
  }
  .gx-diagram .for-light { display: none; }
  :root[data-theme='light'] .gx-diagram .for-dark { display: none; }
  :root[data-theme='light'] .gx-diagram .for-light { display: block; }
  .gx-diagram figcaption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.6rem;
  }
</style>
